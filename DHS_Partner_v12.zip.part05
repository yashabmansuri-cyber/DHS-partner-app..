.dhsChatHeadText{flex:1;min-width:0;line-height:1.1}.dhsChatHeadText b{display:block;font-size:16px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.dhsChatHeadText small{display:flex;align-items:center;gap:5px;color:#fff;font-size:9px;margin-top:5px}.dhsChatStatus{display:inline-block;width:8px;height:8px;border-radius:50%;background:#20c85a;box-shadow:none}
.dhsChatMenu{font-size:25px!important}
.dhsChatBody{flex:1 1 auto;min-height:0;width:100%;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:16px 10px 12px;display:flex;flex-direction:column;gap:8px;background:#061b46;overscroll-behavior:contain}
.dhsChatMsg{position:relative;max-width:82%;padding:9px 11px 8px;border-radius:13px;font-size:11px;line-height:1.38;box-shadow:none;word-break:break-word;white-space:pre-wrap;color:#17243c}
.dhsChatMsg.support{align-self:flex-start;background:#fff;border:0;border-bottom-left-radius:4px}
