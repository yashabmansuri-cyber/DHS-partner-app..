</style>

<style id="dhs-cod-qr-reference-fix">
.dhsPayOverlay{position:fixed!important;inset:0!important;z-index:2147483646!important;background:#061b46!important;color:#fff!important;display:flex!important;flex-direction:column!important;overflow:hidden!important;font-family:inherit}
.dhsPayHead{height:64px;flex:none;display:flex;align-items:center;gap:12px;padding:10px 14px;border-bottom:1px solid rgba(255,255,255,.14);background:#061b46}.dhsPayBack{width:38px;height:38px;border:0;background:transparent;color:#fff;border-radius:50%;display:grid;place-items:center;font-size:28px}.dhsPayHead h3{margin:0;font-size:16px}.dhsPayHead small{display:block;margin-top:3px;color:#b9c9df;font-size:9px}.dhsPayBody{flex:1;overflow:auto;padding:24px 16px 28px;background:#061b46}.dhsPayBody.center{text-align:center}.dhsPayLabel{display:block;font-size:12px;font-weight:800;margin:5px 2px 10px;color:#fff}.dhsPayAmountInput{width:100%;height:58px;border:0;border-radius:12px;background:#fff;color:#17243c;text-align:center;font-size:24px;font-weight:900;outline:none;padding:0 14px}.dhsPayQuick{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px}.dhsPayQuick button{height:42px;border:1px solid #466489;border-radius:10px;background:#102e59;color:#fff;font-weight:800;font-size:11px}.dhsPayQuick button:active{transform:scale(.98)}.dhsPayPrimary{width:100%;height:48px;border:0;border-radius:10px;background:#0b69d1;color:#fff;font-weight:900;font-size:14px;margin-top:18px}.dhsPayInfo{margin-top:20px;border:1px solid #36577e;border-radius:16px;padding:14px;text-align:left;color:#cbd8ea;font-size:10px;line-height:1.55}.dhsPayInfo b{display:block;color:#fff;font-size:11px;margin-bottom:7px}.dhsQrAmount{font-size:26px;font-weight:900;color:#24c957;margin:5px 0 12px}.dhsQrBox{width:min(100%,300px);margin:0 auto;background:#fff;border-radius:14px;padding:10px;display:grid;place-items:center;min-height:300px}.dhsQrBox img,.dhsQrBox canvas{max-width:100%;height:auto!important}.dhsUpiApps{display:flex;justify-content:center;gap:8px;margin:12px auto 8px;flex-wrap:wrap}.dhsUpiApps span{background:#fff;color:#17243c;border-radius:9px;padding:7px 9px;font-size:8px;font-weight:900}.dhsWaiting{display:flex;justify-content:center;align-items:center;gap:7px;color:#1