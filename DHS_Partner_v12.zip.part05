ile>.card:last-of-type{border-radius:0 0 20px 20px!important}

/* Larger startup loading indicator */
.splashLoader{gap:12px!important;min-width:190px!important;font-size:15px!important}
.loaderRing{width:36px!important;height:36px!important;border-width:3px!important}
</style>
<style id="dhs-gap-fix-absolute">
/* DHS FINAL GAP REMOVAL â€” reference layout */

/* Profile: cards are one continuous stack, with no navy strip between them. */
#profile.screen > .card {
  margin-top: 0 !important;
  margin-bottom: 0 !important;
  border-top: 0 !important;
  box-shadow: none !important;
}
#profile.screen > .profileHeroCard {
  border-radius: 20px 20px 0 0 !important;
  border-top: 1px solid #fff !important;
}
#profile.screen > .card:last-child {
  border-radius: 0 0 20px 20px !important;
  border-bottom: 1px solid #fff !important;
}
#profile.screen > .card + .card {
  border-radius: 0 !important;
}

/* Settings: all setting cards touch each other with no navy gap. */
#settings.screen > .settingsCard {
  margin-top: 0 !important;
  margin-bottom: 0 !important;
  border-top: 0 !important;
  box-shadow: none !important;
}
#settings.screen > .settingsCard:first-of-type {
  border-radius: 20px 20px 0 0 !important;
  border-top: 1px solid var(--line) !important;
}
#settings.screen > .settingsCard + .settingsCard {
  border-radius: 0 !important;
}
#settings.screen > .settingsCard:last-of-type {
  border-radius: 0 0 20px 20px !important;
  border-bottom: 1px solid var(--line) !important;
}

/* Bill action row: absolutely no gap, margin or divider between buttons. */
.bill-preview-actions {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 0 !important;
  row-gap: 0 !important;
  column-gap: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  border: 0 !important;
  background: transparent !important;
}
.bill-preview-actions button {
  margin: 0 !important;
  padding-left: 8px !important;
  padding-right: 8px !important;
  border: 0 !important;
  border-left: 0 !important;
  border-right: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
  min-width: 0 !important;
}
.bill-preview-actions button:nth-child(1),
.bill-preview-actions button:nth-child(2),
.bill-preview-actions button:nth-child(3) {
  flex: 0 0 33.333333% !important;
  width: 33.333333% !important;
}
.bill-preview-actions button:nth-child(4),
.bill-preview-actions button:nth-child(5) {
  flex: 0 0 50% !important;
  width: 50% !important;
}
.bill-preview-actions button:nth-child(1) { border-radius: 12px 0 0 12px !important; }
.bill-preview-actions button:nth-child(2) { border-radius: 0 !important; }
.bill-preview-actions button:nth-child(3) { border-radius: 0 12px 12px 0 !important; }
.bill-preview-actions button:nth-child(4) { border-radius: 12px 0 0 12px !important; }
.bill-preview-actions button:nth-child(5) { border-radius: 0 12px 12px 0 !important; }

/* Keep the larger startup loader. */
.splashLoader {
  gap: 14px !important;
  min-width: 210px !important;
  font-size: 16px !important;
}
.loaderRing {
  width: 42px !important;
  height: 42px !important;
  border-width: 4px !important;
}

/* DHS Partner functional controls v13 */
.mapAction{display:flex!important;align-items:center;justify-content:center;gap:7px;cursor:pointer;touch-action:manipulation}
.mapAction svg,.svgBtnIcon svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.acceptedDhsPopup{text-align:center}.acceptedDhsBrand{display:flex;justify-content:center;align-items:center;gap:3px;font-size:34px;font-weight:1000;letter-spacing:-2px;margin:2px 0 8px}.dhsD,.dhsS{color:#061b46}.dhsH{color:#ff7a18}.acceptedLoading{padding:4px 0 10px}.acceptedLoading .flow-spinner{width:48px;height:48px;margin:0 auto 10px}.acceptedLoading h3{margin:0 0 4px}.acceptedLoading p{margin:0;color:#69758a;font-size:11px}.arrivalActions{background:transparent!important;border:0!important;box-shadow:none!important;padding:0!important;bottom:8px!important}.markReachedBtn{width:100%;min-height:58px;border:0;border-radius:19px;background:#12a94a;color:#fff;font-size:17px;font-weight:1000;box-shadow:0 12px 28px #061b4640;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;touch-action:manipulation}.markReachedBtn span{font-size:22px}.phoneSuccessBox{border-radius:28px!important;padding:24px 18px!important}.profileSettingsTitle{display:flex;flex-direction:column;gap:2px;padding:15px 4px 8px;color:#061b46}.profileSettingsTitle b{font-size:20px}.profileSettingsTitle small{font-size:10px;color:#69758a}.profileHeroCard{margin-bottom:0!important}.profileSettingsTitle + .settingsCard{border-radius:20px 20px 0 0!important}.profileSettingsTitle ~ .settingsCard{margin-top:0!important;margin-bottom:0!important;border-top:0!important;border-radius:0!important}.profileSettingsTitle ~ .settingsCard:nth-last-of-type(2){border-radius:0 0 20px 20px!important}.slideTrack.nav{background:#061b46}.slideTrack.nav .slideThumb{background:#ff7a18;color:#fff}.slideTrack.dhs{background:#0a9d42}.slideTrack.dhs .slideThumb{background:#061b46;color:#fff}.slideRange{touch-action:pan-x!important}.partnerMapBottom{z-index:30!important}.mapAction{position:relative;z-index:31!important;pointer-events:auto!important}
</style>
<style>
/* FINAL DHS ACCEPTED ROUTE UI */
.partnerMapOverlay.routeActive .partnerMapTop,
.partnerMapOverlay.routeActive .partnerMapJobCard{display:none!important}
.partnerMapOverlay.routeActive .routeActionPanel{display:block!important}
.routeActionPanel{position:absolute;left:12px;right:12px;bottom:10px;z-index:40;display:none;pointer-events:auto}
.routeActionRow{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}
.routeActionBtn{min-height:70px;border:1px solid #d8e1ee;border-radius:18px;background:#fff;color:#0b2148;display:grid;grid-template-columns:46px 1fr;grid-template-rows:1fr 1fr;align-items:center;text-align:left;padding:8px 12px;box-shadow:0 12px 30px #0004;cursor:pointer;touch-action:manipulation}
.routeActionBtn:active{transform:scale(.985)}
.routeActionBtn .routeSvgIcon{grid-row:1/3;width:40px;height:40px;border-radius:50%;display:grid;place-items:center;color:#fff}
.routeActionBtn .routeSvgIcon svg{width:22px;height:22px;fill:currentColor;stroke:currentColor;stroke-width:1.4}
.routeActionBtn.call .routeSvgIcon{background:#1677ee}.routeActionBtn.nav .routeSvgIcon{background:#0b2148}
.routeActionBtn>span:not(.routeSvgIcon){font-size:14px;font-weight:1000;align-self:end}
.routeActionBtn small{font-size:9px;color:#65738b;font-weight:800;align-self:start}
.routeActionPanel .routeTripCard{position:relative;left:auto;right:auto;bottom:auto;margin:0 0 10px;padding:14px 16px;border-radius:18px;box-shadow:0 10px 28px #0004;display:block!important;pointer-events:none}
.routeActionPanel .routeTripMain{font-size:17px}
.routeCompleteBtn{width:100%;min-height:58px;border:0;border-radius:20px;background:#10a94b;color:#fff;font-size:17px;font-weight:1000;box-shadow:0 12px 28px #0004;display:flex;align-items:center;justify-content:center;gap:9px;cursor:pointer;touch-action:manipulation}
.routeCompleteBtn span{width:28px;height:28px;border-radius:50%;background:#fff;color:#10a94b;display:grid;place-items:center;font-size:19px}
.routeCompleteBtn:disabled{opacity:.8}
.completeSpinner{width:21px!important;height:21px!important;border:3px solid #ffffff80;border-top-color:#fff!important;border-radius:50%!important;background:transparent!important;animation:spin .7s linear infinite;display:inline-block!important}
@keyframes spin{to{transform:rotate(360deg)}}
.phoneSuccessOverlay{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;background:#06132955;backdrop-filter:blur(7px);padding:24px;animation:phonePopIn .22s ease}
.phoneSuccessBox{width:min(360px,92vw);min-height:220px;border-radius:30px;background:#fff;box-shadow:0 25px 70px #0008;border:1px solid #ffffff;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:28px 20px;position:relative;overflow:hidden}
.phoneSuccessIcon{width:70px;height:70px;border-radius:50%;background:#10a94b;color:#fff;display:grid;place-items:center;font-size:42px;font-weight:1000;box-shadow:0 0 0 9px #10a94b22;margin-bottom:14px}
.phoneSuccessTitle{font-size:24px;font-weight:1000;color:#061b46;letter-spacing:-.5px}.phoneSuccessSub{font-size:10px;color:#69758a;margin-top:7px;font-weight:800}
.phoneSuccessRing{position:absolute;width:250px;height:250px;border-radius:50%;border:1px solid #10a94b30;animation:successRing 1.1s ease-out infinite;pointer-events:none}
@keyframes successRing{from{transform:scale(.55);opacity:.8}to{transform:scale(1.25);opacity:0}}
@keyframes phonePopIn{from{opacity:0;transform:scale(.92)}to{opacity:1;transform:scale(1)}}
@media(max-width:380px){.routeActionBtn{grid-template-columns:40px 1fr;min-height:64px;padding:7px 9px}.routeActionBtn .routeSvgIcon{width:36px;height:36px}.routeActionBtn>span:not(.routeSvgIcon){font-size:12px}.routeActionBtn small{font-size:8px}.routeActionPanel{left:9px;right:9px;bottom:9px}}
</style>

<style>
/* DHS Professional Route Screen v14 */
#routeMapFallback{position:absolute;inset:0;width:100%;height:100%;border:0;z-index:0;background:#dcecff;opacity:1;pointer-events:none}
.routeMapFallbackOverlay{position:absolute;inset:0;z-index:1;pointer-events:none;overflow:hidden;background:linear-gradient(145deg,rgba(224,238,252,.34),rgba(203,224,246,.18))}
.fallbackRoad{position:absolute;height:18px;background:rgba(255,255,255,.75);border:1px solid rgba(116,139,164,.28);border-radius:999px;box-shadow:0 2px 5px rgba(31,54,78,.12)}
.fallbackRoad.r1{width:130%;left:-15%;top:35%;transform:rotate(-19deg)}
.fallbackRoad.r2{width:120%;left:-8%;top:54%;transform:rotate(13deg)}
.fallbackRoad.r3{width:105%;left:0;top:72%;transform:rotate(-32deg)}
.fallbackRoute{position:absolute;width:9px;height:58%;left:52%;top:27%;background:linear-gradient(#ff8a18,#ff6a00);border-radius:999px;transform:rotate(24deg);box-shadow:0 0 0 5px rgba(255,138,24,.18),0 0 22px rgba(255,106,0,.5)}
.fallbackPin{position:absolute;width:48px;height:48px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:1000;border:4px solid #fff;box-shadow:0 8px 24px rgba(0,0,0,.28)}
.fallbackPin.me{left:28%;bottom:25%;background:#1769e8;font-size:23px}.fallbackPin.customer{right:20%;top:27%;background:#e53935;font-size:18px}
.partnerMapOverlay.routeActive .routeMapFallbackOverlay{display:block}.routeMapFallbackOverlay{display:none}
.routeNavBanner{background:#0b2148!important;border-radius:20px!important;box-shadow:0 14px 35px rgba(6,19,41,.28)!important;border:1px solid rgba(255,255,255,.16)!important;backdrop-filter:blur(8px)!important}
.routeNavArrow svg{width:25px;height:25px;fill:#0b2148}
.routeActionPanel{left:12px!important;right:12px!important;bottom:12px!important}
.routeActionRow{gap:12px!important;margin-bottom:10px!important}
.routeActionBtn{min-height:66px!important;border-radius:17px!important;box-shadow:0 8px 24px rgba(6,27,70,.16)!important}
.routeActionBtn .routeSvgIcon{width:40px!important;height:40px!important}
.routeActionPanel .routeTripCard{margin-bottom:10px!important;padding:14px 16px!important;border-radius:18px!important}
.routeCompleteBtn{min-height:60px!important;border-radius:18px!important;background:linear-gradient(180deg,#16b653,#0b9f42)!important;box-shadow:0 10px 26px rgba(16,169,75,.28)!important}
@media(max-width:380px){.routeActionPanel{left:10px!important;right:10px!important;bottom:10px!important}.routeActionBtn{min-height:62px!important}.routeActionBtn>span:not(.routeSvgIcon){font-size:12px!important}.routeActionBtn small{font-size:8px!important}.routeCompleteBtn{min-height:58px!important;font-size:16px!important}}

/* Post-completion idle home: only DHS Partner + Start Earning + Waiting for bookings. */
.idleHidden{display:none!important}
body.idleHomeActive .top,body.idleHomeActive .bottom{display:none!important}
.idleWaitingHome{position:fixed;inset:0;z-index:99999;background:linear-gradient(145deg,#061b46,#174b9b);display:flex;align-items:center;justify-content:center;padding:24px;overflow:hidden}
.idleWaitingBox{width:min(390px,100%);padding:34px 24px;text-align:center;border:1px solid rgba(255,255,255,.22);border-radius:30px;background:rgba(255,255,255,.10);box-shadow:0 25px 80px rgba(0,0,0,.28);backdrop-filter:blur(18px);color:#fff}
.idleDhs{font-size:42px;font-weight:1000;letter-spacing:3px;margin-bottom:22px}.idleDhs span{color:#ff7a18}.idleDhs b{color:#fff}
.idleSpinner{width:72px;height:72px;border-radius:50%;margin:0 auto 20px;border:5px solid rgba(255,255,255,.20);border-top-color:#ff7a18;display:grid;place-items:center;animation:spin .9s linear infinite}
.idleSpinner i{width:12px;height:12px;border-radius:50%;background:#ff7a18;box-shadow:0 0 22px rgba(255,122,24,.85)}
.idleWaitingBox h2{margin:0;font-size:25px}.idleTitle{margin-top:8px;font-size:21px;font-weight:1000;color:#ff9a4d}.idleWaitingBox p{margin:4px 0 12px;font-size:18px;font-weight:900}.idleWaitingBox small{display:block;color:#dbe8ff;line-height:1.5;font-size:10px}
</style>
<style id="dhs-profile-final-layout-fix">
/* FINAL PROFILE LAYOUT FIX: content starts immediately below the sticky header. */
#profile.screen.active{
  display:block !important;
  position:relative !important;
  margin:0 !important;
  padding:0 12px 104px !important;
  min-height:0 !important;
  height:auto !important;
  background:transparent !important;
}
#profile.screen.active > .profileHeroCard,
#profile.screen.active > .profileSettingsTitle,
#profile.screen.active > .settingsCard,
#profile.screen.active > .card:last-child{
  position:relative !important;
  order:initial !important;
  transform:none !important;
}
#profile.screen.active > .profileHeroCard{
  display:block !important;
  margin:0 !important;
}
#profile.screen.active > .profileSettingsTitle{
  display:flex !important;
  margin:0 !important;
  padding:15px 4px 8px !important;
}
#profile.screen.active > .settingsCard{
  margin-top:0 !important;
  margin-bottom:0 !important;
}
/* Never preserve an old scroll offset when Profile is opened. */
html,body{
  scroll-behavior:auto !important;
}
</style>
<style id="dhs-profile-scroll-lock-fix">
/* PROFILE OPEN: always start at the top, directly under the fixed/sticky header. */
html, body { scroll-behavior:auto !important; }
html, body, #root { overflow-x:hidden !important; }
#root, .app, main.page { margin-top:0 !important; }
main.page { padding-top:0 !important; }
#profile.screen.active {
  margin-top:0 !important;
  padding-top:0 !important;
  scroll-margin-top:0 !important;
}
#profile.screen.active .profileHeroCard {
  margin-top:0 !important;
  transform:none !important;
}
</style>
<style id="dhs-profile-android-scroll-fix">
/* Android WebView profile navigation fix: never inherit the previous page scroll. */
html,body{overflow-anchor:none!important;scroll-behavior:auto!important;}
#root,.app,main.page{overflow-anchor:none!important;}
#profile.screen{display:none;}
#profile.screen.active{display:block!important;position:relative!important;top:auto!important;left:auto!important;transform:none!important;margin:0!important;padding:0 12px 104px!important;min-height:calc(100vh - 68px)!important;overflow:visible!important;}
#profile.screen.active .profileHeroCard{margin:0!important;transform:none!important;}
#profile.screen.active .profileSettingsTitle{margin:0!important;}
</style>
