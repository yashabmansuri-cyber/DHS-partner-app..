<section id="earnings" class="screen"><div class="sectionTitle">Earnings</div><div class="statgrid"><div class="stat"><small>Total Jobs Completed</small><strong id="statJobs">0</strong><span class="muted">All completed jobs</span></div><div class="stat earnToday" onclick="openTodayEarnings()"><small>Today Earning</small><strong id="statPay">â‚¹0</strong><span class="muted" id="todayPayMeta">0 paid jobs today â€º</span></div><div class="stat weekEarn" onclick="openWeeklyEarnings()"><small>This Week Earning</small><strong id="statWeekPay">â‚¹0</strong><span class="muted" id="weekPayMeta">View daily earning â€º</span></div><div class="stat" onclick="go('bills',document.querySelector('[data-page=\"bills\"]'))"><small>Total Bills</small><strong id="statBills">0</strong><span class="muted">View all bills â€º</span></div></div><div class="sectionTitle">Completed Jobs</div><div id="completedList"></div></section>
